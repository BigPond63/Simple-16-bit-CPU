start:
    addi r0, 0
    addi r1, 6 // n = 6 -> Factorial of this number
    addi r2, 1 // result = 1 currently, must multiply for final factorial
loop:   
    bez r1, end // if n == 0, jump to done
    mul r2, r1 // result = result * n
    disp r2  // show progress
    addi r1, -1 // n = n - 1
    bez r0, loop // r0 is always 0, so this always jumps back
end:   
    bez r0, end